<mujoco model="real_wheelleg_sym_rot90_v1">
    <compiler angle="radian" meshdir="assets"/>
    <option timestep="0.001"
            gravity="0 0 -9.81"
            iterations="100"
            tolerance="1e-8"/>

    <default>
        <joint damping="0.02" armature="0.001"/>
        <geom contype="0" conaffinity="0"/>
    </default>

    <asset>
        <texture type="skybox" name="sky" builtin="gradient"
                 rgb1="0.7 0.82 0.98" rgb2="0.35 0.55 0.85" width="256" height="256"/>
        <texture type="2d" name="groundplane" builtin="checker"
                 rgb1="0.3 0.35 0.4" rgb2="0.18 0.22 0.27"
                 markrgb="0.9 0.9 0.9" width="300" height="300"/>
        <material name="mat_ground" texture="groundplane" texuniform="true"
                  texrepeat="8 8" reflectance="0.2"/>
        <mesh name="body_mesh" file="body.stl"/>
        <mesh name="L1_mesh" file="sym_L1.STL"/>
        <mesh name="L2_mesh" file="sym_L2.STL"/>
        <mesh name="L3_mesh" file="sym_L3.STL"/>
        <mesh name="L4_mesh" file="sym_L4.STL"/>
        <mesh name="L5_mesh" file="sym_L5.STL"/>
        <mesh name="L6_mesh" file="sym_L6.STL"/>
        <mesh name="LW_mesh" file="sym_LW.STL"/>
        <mesh name="R1_mesh" file="R1.stl"/>
        <mesh name="R2_mesh" file="R2.stl"/>
        <mesh name="R3_mesh" file="R3.stl"/>
        <mesh name="R4_mesh" file="R4.stl"/>
        <mesh name="R5_mesh" file="R5.stl"/>
        <mesh name="R6_mesh" file="R6.stl"/>
        <mesh name="RW_mesh" file="RW.stl"/>
    </asset>

    <worldbody>
        <geom name="floor" type="plane" size="10 10 0.02" pos="0 0 -0.8"
              material="mat_ground" rgba="1 1 1 1"/>
        <light name="main_light"
               pos="0 -2 2"
               dir="0 1 -1"
               diffuse="1 1 1"/>

        <camera name="track"
                pos="0 -1.2 0.5"
                xyaxes="1 0 0 0 0.4 1"/>

        <body name="base" pos="0 0 0" quat="0.70710678 0.70710678 0 0">
            <geom name="body_visual"
                  type="mesh"
                  mesh="body_mesh"
                  contype="0"
                  conaffinity="0"
                  rgba="0.25 0.25 0.25 1"/>

            <geom name="base_ref"
                  type="box"
                  size="0.03 0.03 0.03"
                  rgba="0.2 0.8 0.2 0.4"/>


            <!-- ================= L side = mirror of R side (以右边为准) ================= -->

            <!-- rear drive chain: base -> L1 -> L2 -->
            <body name="L_L1" pos="0.179340 -0.038020 -0.039520">
                <joint name="L_J_base_L1"
                       type="hinge"
                       axis="1 0 0"
                       damping="0.02"
                       armature="0.001"/>
                <inertial pos="0 0 0" mass="0.092467" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="L_L1_visual"
                      type="mesh"
                      mesh="L1_mesh"
                      pos="-0.179340 0.038020 0.039520"
                      contype="0"
                      conaffinity="0"
                      rgba="0.1 0.35 0.95 1"/>

                <body name="L_L2" pos="-0.006500 -0.062070 0.094910">
                    <joint name="L_J_L1_L2"
                           type="hinge"
                           axis="1 0 0"
                           damping="0.02"
                           armature="0.001"/>
                    <inertial pos="0 0 0" mass="0.036733" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="L_L2_visual"
                      type="mesh"
                      mesh="L2_mesh"
                      pos="-0.172840 0.100090 -0.055390"
                      contype="0"
                      conaffinity="0"
                      rgba="0.1 0.35 0.95 1"/>
                </body>
            </body>

            <!-- front drive chain: base -> L1 -> L2 -->
            <body name="L_L5" pos="0.153840 -0.038020 -0.039520">
                <joint name="L_J_base_L5"
                       type="hinge"
                       axis="1 0 0"
                       damping="0.02"
                       armature="0.001"/>
                <inertial pos="0 0 0" mass="0.424333" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="L_L5_visual"
                      type="mesh"
                      mesh="L5_mesh"
                      pos="-0.153840 0.038020 0.039520"
                      contype="0"
                      conaffinity="0"
                      rgba="0.1 0.35 0.95 1"/>

                <!-- L3-L5 is now a real hinge joint -->
                <body name="L_L3" pos="0.019000 -0.067740 -0.090940">
                    <joint name="L_J_L3_L5"
                           type="hinge"
                           axis="1 0 0"
                           damping="0.02"
                           armature="0.001"/>
                    <inertial pos="0 0 0" mass="0.061560" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="L_L3_visual"
                      type="mesh"
                      mesh="L3_mesh"
                      pos="-0.172840 0.105760 0.130460"
                      contype="0"
                      conaffinity="0"
                      rgba="0.1 0.35 0.95 1"/>

                    <body name="L_L4" pos="0.000000 0.057750 -0.033980">
                        <joint name="L_J_L3_L4"
                               type="hinge"
                               axis="1 0 0"
                               damping="0.02"
                               armature="0.001"/>
                        <inertial pos="0 0 0" mass="0.025570" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="L_L4_visual"
                      type="mesh"
                      mesh="L4_mesh"
                      pos="-0.172840 0.048010 0.164440"
                      contype="0"
                      conaffinity="0"
                      rgba="0.1 0.35 0.95 1"/>
                    </body>
                </body>

                <!-- L5-L6 is now a real hinge joint -->
                <body name="L_L6" pos="0.018000 -0.125440 -0.168410">
                    <joint name="L_J_L5_L6"
                           type="hinge"
                           axis="1 0 0"
                           damping="0.02"
                           armature="0.001"/>
                    <inertial pos="0 0 0" mass="0.317933" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="L_L6_visual"
                      type="mesh"
                      mesh="L6_mesh"
                      pos="-0.171840 0.163460 0.207930"
                      contype="0"
                      conaffinity="0"
                      rgba="0.1 0.35 0.95 1"/>

                    <body name="L_WHEEL" pos="0.037050 -0.175940 0.177600">
                        <joint name="L_J_W"
                               type="hinge"
                               axis="1 0 0"
                               damping="0.01"
                               armature="0.001"/>
                        <inertial pos="0 0 0" mass="0.25" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="L_WHEEL_visual"
                      type="mesh"
                      mesh="LW_mesh"
                      pos="-0.208890 0.339400 0.030330"
                      contype="0"
                      conaffinity="0"
                      rgba="0.03 0.03 0.03 1"/>
                    </body>
                </body>
            </body>


            <!-- ================= R side real linkage V2 ================= -->

            <!-- rear drive chain: base -> L1 -> L2 -->
            <body name="R_L1" pos="-0.179340 -0.038020 -0.039520">
                <joint name="R_J_base_L1"
                       type="hinge"
                       axis="1 0 0"
                       damping="0.02"
                       armature="0.001"/>
                <inertial pos="0 0 0" mass="0.092467" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="R_L1_visual"
                      type="mesh"
                      mesh="R1_mesh"
                      pos="0.179340 0.038020 0.039520"
                      contype="0"
                      conaffinity="0"
                      rgba="0.95 0.25 0.1 1"/>

                <body name="R_L2" pos="0.006500 -0.062070 0.094910">
                    <joint name="R_J_L1_L2"
                           type="hinge"
                           axis="1 0 0"
                           damping="0.02"
                           armature="0.001"/>
                    <inertial pos="0 0 0" mass="0.036733" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="R_L2_visual"
                      type="mesh"
                      mesh="R2_mesh"
                      pos="0.172840 0.100090 -0.055390"
                      contype="0"
                      conaffinity="0"
                      rgba="0.95 0.25 0.1 1"/>
                </body>
            </body>

            <!-- front drive chain: base -> L1 -> L2 -->
            <body name="R_L5" pos="-0.153840 -0.038020 -0.039520">
                <joint name="R_J_base_L5"
                       type="hinge"
                       axis="1 0 0"
                       damping="0.02"
                       armature="0.001"/>
                <inertial pos="0 0 0" mass="0.424333" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="R_L5_visual"
                      type="mesh"
                      mesh="R5_mesh"
                      pos="0.153840 0.038020 0.039520"
                      contype="0"
                      conaffinity="0"
                      rgba="0.95 0.25 0.1 1"/>

                <!-- L3-L5 is now a real hinge joint -->
                <body name="R_L3" pos="-0.019000 -0.067740 -0.090940">
                    <joint name="R_J_L3_L5"
                           type="hinge"
                           axis="1 0 0"
                           damping="0.02"
                           armature="0.001"/>
                    <inertial pos="0 0 0" mass="0.061560" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="R_L3_visual"
                      type="mesh"
                      mesh="R3_mesh"
                      pos="0.172840 0.105760 0.130460"
                      contype="0"
                      conaffinity="0"
                      rgba="0.95 0.25 0.1 1"/>

                    <body name="R_L4" pos="0.000000 0.057750 -0.033980">
                        <joint name="R_J_L3_L4"
                               type="hinge"
                               axis="1 0 0"
                               damping="0.02"
                               armature="0.001"/>
                        <inertial pos="0 0 0" mass="0.025570" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="R_L4_visual"
                      type="mesh"
                      mesh="R4_mesh"
                      pos="0.172840 0.048010 0.164440"
                      contype="0"
                      conaffinity="0"
                      rgba="0.95 0.25 0.1 1"/>
                    </body>
                </body>

                <!-- L5-L6 is now a real hinge joint -->
                <body name="R_L6" pos="-0.018000 -0.125440 -0.168410">
                    <joint name="R_J_L5_L6"
                           type="hinge"
                           axis="1 0 0"
                           damping="0.02"
                           armature="0.001"/>
                    <inertial pos="0 0 0" mass="0.317933" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="R_L6_visual"
                      type="mesh"
                      mesh="R6_mesh"
                      pos="0.171840 0.163460 0.207930"
                      contype="0"
                      conaffinity="0"
                      rgba="0.95 0.25 0.1 1"/>

                    <body name="R_WHEEL" pos="-0.037050 -0.175940 0.177600">
                        <joint name="R_J_W"
                               type="hinge"
                               axis="1 0 0"
                               damping="0.01"
                               armature="0.001"/>
                        <inertial pos="0 0 0" mass="0.25" diaginertia="0.0005 0.0005 0.0005"/>

                <geom name="R_WHEEL_visual"
                      type="mesh"
                      mesh="RW_mesh"
                      pos="0.208890 0.339400 0.030330"
                      contype="0"
                      conaffinity="0"
                      rgba="0.03 0.03 0.03 1"/>
                    </body>
                </body>
            </body>


        </body>
    </worldbody>

    <equality>
        <!-- <connect name="L_close_L2_L3" body1="L_L2" body2="L_L3" anchor="0.172840 -0.200770 -0.034550" solref="0.002 1" solimp="0.95 0.99 0.001"/> -->
        <connect name="L_close_L4_L6" body1="L_L4" body2="L_L6" anchor="0.172840 -0.105720 -0.241910" solref="0.002 1" solimp="0.95 0.99 0.001"/>
        <connect name="R_close_L2_L3" body1="R_L2" body2="R_L3" anchor="-0.172840 -0.200770 -0.034550" solref="0.002 1" solimp="0.95 0.99 0.001"/>
        <connect name="R_close_L4_L6" body1="R_L4" body2="R_L6" anchor="-0.172840 -0.105720 -0.241910" solref="0.002 1" solimp="0.95 0.99 0.001"/>
    </equality>

    <actuator>

        <position name="L_back_drive_pos"
                  joint="L_J_base_L1"
                  kp="800"
                  ctrllimited="true"
                  ctrlrange="-1.2 1.2"/>

        <position name="L_front_drive_pos"
                  joint="L_J_base_L5"
                  kp="800"
                  ctrllimited="true"
                  ctrlrange="-1.2 1.2"/>

        <motor name="L_wheel_motor"
               joint="L_J_W"
               gear="1"
               ctrllimited="true"
               ctrlrange="-4.92 4.92"/>

        <position name="R_back_drive_pos"
                  joint="R_J_base_L1"
                  kp="800"
                  ctrllimited="true"
                  ctrlrange="-1.2 1.2"/>

        <position name="R_front_drive_pos"
                  joint="R_J_base_L5"
                  kp="800"
                  ctrllimited="true"
                  ctrlrange="-1.2 1.2"/>

        <motor name="R_wheel_motor"
               joint="R_J_W"
               gear="1"
               ctrllimited="true"
               ctrlrange="-4.92 4.92"/>

    </actuator>
</mujoco>
